# Configuración de Supabase
VITE_SUPABASE_URL=tu_url_de_supabase
VITE_SUPABASE_ANON_KEY=tu_clave_anonima_de_supabase

# Configuración de Digital Ocean AI Agent
# Obtén estas credenciales desde tu panel de Digital Ocean
# IMPORTANTE: La URL NO debe incluir /chat/completions al final
# Ejemplo correcto: https://vj2u4ywjmhhxa6mhycj35rdh.agents.do-ai.run
VITE_DO_AGENT_ENDPOINT=https://tu-agent-id.agents.do-ai.run
VITE_DO_AGENT_ACCESS_KEY=tu_clave_de_acceso_digital_ocean
