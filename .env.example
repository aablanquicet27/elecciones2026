# DigitalOcean Agent Configuration
# Obtén estas credenciales desde tu panel de DigitalOcean Agent
# URL del endpoint de tu agente (sin /api/v1/chat/completions al final)
VITE_DO_AGENT_ENDPOINT=https://tu-agente.agents.do-ai.run

# Clave de acceso del agente (Access Key)
VITE_DO_AGENT_ACCESS_KEY=tu_clave_de_acceso_aqui

